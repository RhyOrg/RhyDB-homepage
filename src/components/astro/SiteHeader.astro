---
import logoUrl from '../../rhydb-logo-white.png';
import { withBase, withoutBase } from '../../lib/paths';

interface Props {
    pathname: string;
}

const navigation = [
    { path: '/', label: 'Home' },
    { path: '/docs', label: 'Documentation' },
    { path: '/exercises', label: 'Exercises' },
    { path: '/console', label: 'Console' },
];
const currentPath = withoutBase(Astro.props.pathname).replace(/\/$/, '') || '/';
const isActive = (path: string) =>
    path === '/' ? currentPath === '/' : currentPath === path || currentPath.startsWith(`${path}/`);
---

<header class='site-header sticky top-0 z-40'>
    <div class='site-navbar navbar mx-auto w-full max-w-7xl px-4 lg:px-6'>
        <div class='navbar-start'>
            <a class='site-brand flex items-center hover:no-underline' href={withBase('/')} aria-label='Home'>
                <img class='h-8 w-auto' src={logoUrl.src} alt='' aria-hidden='true' />
            </a>
        </div>
        <nav class='site-nav navbar-center hidden lg:block' aria-label='Main navigation'>
            <ul class='menu menu-horizontal gap-1 px-1'>
                {
                    navigation.map((item) => (
                        <li>
                            <a href={withBase(item.path)} aria-current={isActive(item.path) ? 'page' : undefined}>
                                {item.label}
                            </a>
                        </li>
                    ))
                }
            </ul>
        </nav>
        <div class='navbar-end gap-2'>
            <a
                class='btn hidden btn-ghost btn-sm sm:inline-flex'
                href='https://github.com/RhyOrg/RhyDB'
                target='_blank'
                rel='noreferrer'
            >
                GitHub
            </a>
            <details class='site-mobile-menu dropdown dropdown-end lg:hidden'>
                <summary class='btn btn-square btn-ghost' aria-label='Open navigation'>
                    <svg
                        viewBox='0 0 24 24'
                        width='22'
                        height='22'
                        fill='none'
                        stroke='currentColor'
                        stroke-width='2'
                        aria-hidden='true'
                    >
                        <path d='M4 7h16M4 12h16M4 17h16'></path>
                    </svg>
                </summary>
                <nav
                    class='dropdown-content z-50 mt-2 w-64 border border-neutral-content/20 bg-neutral p-2 shadow'
                    aria-label='Mobile navigation'
                >
                    <ul class='menu w-full'>
                        {
                            navigation.map((item) => (
                                <li>
                                    <a
                                        href={withBase(item.path)}
                                        aria-current={isActive(item.path) ? 'page' : undefined}
                                    >
                                        {item.label}
                                    </a>
                                </li>
                            ))
                        }
                        <li class='sm:hidden'>
                            <a href='https://github.com/RhyOrg/RhyDB' target='_blank' rel='noreferrer'>GitHub</a>
                        </li>
                    </ul>
                </nav>
            </details>
        </div>
    </div>
</header>
