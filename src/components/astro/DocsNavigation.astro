---
import type { CollectionEntry } from 'astro:content';
import { withBase } from '../../lib/paths';

interface Props {
    entries: CollectionEntry<'docs'>[];
    currentPath: string;
}

const { entries, currentPath } = Astro.props;
const sections = ['Concepts', 'Tutorials', 'Reference'] as const;
const sorted = [...entries].sort((a, b) => a.data.order - b.data.order);
const navClass = (active: boolean) =>
    `grid h-auto min-h-8 w-full min-w-0 grid-cols-[auto_minmax(0,1fr)] whitespace-normal overflow-hidden${active ? ' bg-primary/12 font-semibold text-primary' : ''}`;
---

<ul class='menu w-full gap-0.5 menu-sm'>
    <li>
        <a
            href={withBase('/docs')}
            class={navClass(currentPath === '/docs')}
            aria-current={currentPath === '/docs' ? 'page' : undefined}
            ><span class='min-w-0 break-words'>Overview</span></a
        >
    </li>
    {
        sections.map((section) => (
            <li class='mt-3'>
                <h2 class='menu-title'>{section}</h2>
                <ul>
                    {sorted
                        .filter((entry) => entry.data.section === section)
                        .map((entry) => {
                            const path = `/docs/${entry.id}`;
                            return (
                                <li>
                                    <a
                                        href={withBase(path)}
                                        class={navClass(currentPath === path)}
                                        aria-current={currentPath === path ? 'page' : undefined}
                                    >
                                        <span class='min-w-0 break-words'>{entry.data.title}</span>
                                    </a>
                                </li>
                            );
                        })}
                </ul>
            </li>
        ))
    }
</ul>
