---
interface Props {
    id?: string;
    class?: string;
    level?: 2 | 3;
}

const { id, class: className, level = 2 } = Astro.props;
const Heading = level === 3 ? 'h3' : 'h2';
---

<Heading id={id} class:list={['section-heading', className]}>
    {
        id && (
            <a
                class='section-heading-link'
                href={`#${id}`}
                aria-label='Link to this section'
                data-prefix={'#'.repeat(level)}
            />
        )
    }
    <slot />
</Heading>

<style>
    .section-heading {
        scroll-margin-top: 4rem;
    }

    .section-heading-link {
        color: var(--color-primary);
        text-decoration: none;
    }

    .section-heading-link::before {
        margin-right: 0.45rem;
        content: attr(data-prefix);
    }
</style>
