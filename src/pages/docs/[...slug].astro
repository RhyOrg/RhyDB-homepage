---
import { getCollection, render, type CollectionEntry } from 'astro:content';
import SectionHeading from '../../components/astro/SectionHeading.astro';
import SubsectionHeading from '../../components/astro/SubsectionHeading.astro';
import DocumentationLayout from '../../layouts/DocumentationLayout.astro';

export async function getStaticPaths() {
    const entries = await getCollection('docs');
    return entries.map((entry) => ({ params: { slug: entry.id }, props: { entry } }));
}

interface Props {
    entry: CollectionEntry<'docs'>;
}

const { entry } = Astro.props;
const { Content } = await render(entry);
const path = `/docs/${entry.id}`;
---

<DocumentationLayout
    title={entry.data.title}
    description={entry.data.description}
    lead={entry.data.lead}
    currentPath={path}
>
    <Content components={{ h2: SectionHeading, h3: SubsectionHeading }} />
</DocumentationLayout>
