{
    "name": "rhydb-web-client",
    "version": "0.1.0",
    "private": true,
    "type": "module",
    "description": "Web interface for querying and learning RhyDB",
    "engines": {
        "node": ">=24"
    },
    "scripts": {
        "wasm:download": "mkdir -p .rhydb-wasm && wget -qO- https://github.com/GenSpectrum/LAPIS-SILO/releases/download/v0.13.2/rhydb-wasm-0.13.2.tar.gz | tar -xz -C .rhydb-wasm",
        "example-data": "node scripts/prepare-example-data.mjs",
        "predev:wasm": "cross-env PUBLIC_RHYDB_WASM_ENABLED=true node scripts/prepare-public.mjs",
        "dev:wasm": "cross-env PUBLIC_RHYDB_WASM_ENABLED=true astro dev",
        "predev": "node scripts/prepare-public.mjs",
        "dev": "astro dev",
        "prebuild": "node scripts/prepare-public.mjs",
        "build": "astro check && astro build",
        "preview": "astro preview",
        "check": "astro check",
        "test": "vitest run",
        "format": "prettier --write \"./**/*.{astro,js,jsx,ts,tsx,json,css,md,mdx,mjs}\"",
        "check-format": "prettier --check \"./**/*.{astro,js,jsx,ts,tsx,json,css,md,mdx,mjs}\""
    },
    "dependencies": {
        "@astrojs/check": "^0.9.10",
        "@astrojs/mdx": "^7.0.5",
        "@astrojs/react": "^6.0.2",
        "@codemirror/commands": "^6.10.3",
        "@codemirror/language": "^6.10.2",
        "@codemirror/lint": "^6.9.7",
        "@fontsource-variable/jetbrains-mono": "^5.3.0",
        "@lezer/highlight": "^1.2.1",
        "@nightingale-elements/nightingale-manager": "^5.6.0",
        "@nightingale-elements/nightingale-msa": "^5.6.0",
        "@nightingale-elements/nightingale-navigation": "^5.6.0",
        "@uiw/react-codemirror": "^4.23.0",
        "@zip.js/zip.js": "^2.8.34",
        "astro": "^7.1.6",
        "canvas-confetti": "^1.9.4",
        "prettier-plugin-astro": "^0.14.1",
        "react": "^19.2.8",
        "react-dom": "^19.2.8",
        "yaml": "^2.9.0"
    },
    "devDependencies": {
        "@tailwindcss/vite": "^4.3.3",
        "@types/canvas-confetti": "^1.9.0",
        "@types/node": "^25.9.3",
        "@types/react": "^19.2.18",
        "@types/react-dom": "^19.2.4",
        "cross-env": "^10.1.0",
        "daisyui": "^5.7.4",
        "prettier": "^3.8.3",
        "prettier-plugin-tailwindcss": "^0.8.1",
        "tailwindcss": "^4.3.3",
        "typescript": "^6.0.3",
        "vite": "^8.1.5",
        "vitest": "^4.1.10"
    }
}
